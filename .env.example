# ==============================================================================
# ANTI-FRAUD PLACEMENT VERIFICATION AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Prefix with VITE_ to expose to client)
# ------------------------------------------------------------------------------
# Public institutional name displayed in header and reports
VITE_COLLEGE_NAME="State Institute of Technology & Science"

# Public placement office portal title
VITE_APP_TITLE="Anti-Fraud Placement Verification Agent"

# Public placement desk contact email shown on student notices
VITE_TPO_DESK_EMAIL="placement-cell@college.edu"


# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER-SIDE SECRETS (NEVER EXPOSE TO BROWSER / CLIENT)
# ------------------------------------------------------------------------------
# These variables require a secure backend/server-side runtime (e.g., Node/Express, Python).
# They MUST NOT be prefixed with VITE_ or imported into browser-side React components.

# VARIABLE NAME: SMTP_SERVER
# PURPOSE: Hostname of your institutional or cloud SMTP provider for dispatching fraud alerts
# WHERE TO GET IT: Your email service provider (e.g., smtp.gmail.com, smtp.office365.com, or college mail server)
# SCOPE: PRIVATE (Server-Side only)
SMTP_SERVER=smtp.gmail.com

# VARIABLE NAME: SMTP_PORT
# PURPOSE: Port used for secure STARTTLS/TLS mail delivery
# WHERE TO GET IT: Typically 587 (STARTTLS) or 465 (SSL)
# SCOPE: PRIVATE (Server-Side only)
SMTP_PORT=587

# VARIABLE NAME: SMTP_EMAIL
# PURPOSE: Dedicated sender mailbox address authenticated with the mail server
# WHERE TO GET IT: Registered by the college IT administrator (e.g., tpo-alerts@college.edu)
# SCOPE: PRIVATE (Server-Side only)
SMTP_EMAIL=tpo-alerts@college.edu

# VARIABLE NAME: SMTP_PASSWORD
# PURPOSE: Secure App Password or SMTP Auth token
# WHERE TO GET IT: Generated from your email provider's security settings (e.g., Google App Passwords)
# SCOPE: PRIVATE (Server-Side only - CRITICAL SECRET)
SMTP_PASSWORD=

# VARIABLE NAME: TPO_EMAIL
# PURPOSE: Official mailbox of the Training & Placement Officer to receive fraud incident reports
# WHERE TO GET IT: Official designation email of the Placement Officer (e.g., mmohiteaniket248@gmail.com)
# SCOPE: PRIVATE (Server-Side only)
TPO_EMAIL=mmohiteaniket248@gmail.com
